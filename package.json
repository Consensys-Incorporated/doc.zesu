{
  "name": "docs-template",
  "version": "1.19.0",
  "private": true,
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "docusaurus start",
    "build": "docusaurus build",
    "swizzle": "docusaurus swizzle",
    "deploy": "docusaurus deploy",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "gen-api": "docusaurus gen-api-docs all",
    "clean-api": "docusaurus clean-api-docs all",
    "glossary:generate": "node scripts/generate-glossary.js",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "typecheck": "tsc",
    "typecheck-staged": "tsc-files --noEmit",
    "lint": "npm run lint:js && npm run lint:style",
    "lint:js": "eslint . --ext js,jsx,ts,tsx --max-warnings=0",
    "lint:style": "stylelint \"**/*.css\"",
    "lint:fix": "npm run lint:js -- --fix",
    "format": "prettier --write '{blog,docs,src,static}/**/*.{md,mdx,ts,js,tsx,jsx,json}'",
    "format:docs": "prettier --write \"docs/**/*.{md,mdx}\"",
    "format:docs:check": "prettier --check \"docs/**/*.{md,mdx}\"",
    "prepare": "node scripts/husky-prepare.js"
  },
  "lint-staged": {
    "src/**/*.{ts,js,jsx,tsx}": "npm run lint:fix",
    "**/*.{ts,tsx}": "npm run typecheck-staged",
    "**/*.css": "npm run lint:style",
    "**/*.{ts,js,tsx,jsx,json}": "prettier --write",
    "**/*.{md,mdx}": "prettier --write"
  },
  "dependencies": {
    "@docusaurus/core": "^3.10.0",
    "@docusaurus/plugin-google-gtag": "^3.10.0",
    "@docusaurus/plugin-google-tag-manager": "^3.10.0",
    "@docusaurus/preset-classic": "^3.10.0",
    "@docusaurus/theme-mermaid": "^3.10.0",
    "@easyops-cn/docusaurus-search-local": "0.55.0",
    "@mdx-js/react": "^3.1.1",
    "@mermaid-js/layout-elk": "^0.1.9",
    "clsx": "^1.2.1",
    "docusaurus-plugin-copy-page-button": "^0.5.2",
    "docusaurus-plugin-llms": "^0.4.0",
    "github-slugger": "^1.5.0",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "open-ask-ai": "^0.7.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^18.2.0",
    "@commitlint/config-conventional": "^18.1.0",
    "@docusaurus/eslint-plugin": "^3.10.0",
    "@docusaurus/module-type-aliases": "^3.10.0",
    "@docusaurus/tsconfig": "^3.10.0",
    "@docusaurus/types": "^3.10.0",
    "@typescript-eslint/parser": "^6.13.1",
    "commitizen": "^4.3.2",
    "cz-conventional-changelog": "^3.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "prettier": "^3.9.10",
    "stylelint": "^16.0.0 ",
    "stylelint-config-standard": "^39.0.0",
    "tsc-files": "^1.1.4",
    "typescript": "^5.9.3"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "engines": {
    "node": "24.22.2"
  },
  "overrides": {
    "katex": "0.18.10",
    "minimatch@9.0.3": "11.0.5",
    "serialize-javascript": "7.1.4",
    "sockjs": {
      "uuid": "11.1.1"
    },
    "tinypool": "2.2.0"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  }
}
